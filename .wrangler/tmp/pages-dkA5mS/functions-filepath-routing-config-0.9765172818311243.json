{
  "routes": [
    {
      "routePath": "/api/auth/:all*",
      "mountPath": "/api/auth",
      "method": "",
      "module": [
        "api/auth/[[all]].ts:onRequest"
      ]
    },
    {
      "routePath": "/api/import-firebase-users",
      "mountPath": "/api",
      "method": "POST",
      "module": [
        "api/import-firebase-users.ts:onRequestPost"
      ]
    },
    {
      "routePath": "/api/import-staff-users",
      "mountPath": "/api",
      "method": "POST",
      "module": [
        "api/import-staff-users.ts:onRequestPost"
      ]
    },
    {
      "routePath": "/api/:path*",
      "mountPath": "/api",
      "method": "",
      "module": [
        "api/[[path]].ts:onRequest"
      ]
    }
  ],
  "baseURL": "/"
}